; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Star-RTS"
config/description="RTS espacial em 3D: Legião Solar (humanos), Núcleo Sintético (robôs) e Enxame Kheth (insetos). Modelos gerados no Blender."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/game_state.gd"
Net="*res://scripts/net.gd"
Sfx="*res://scripts/sound.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/screen_space_aa.web=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[shader_globals]

fog_tex={
"type": "sampler2D",
"value": ""
}
fog_on={
"type": "float",
"value": 0.0
}
fog_size={
"type": "vec2",
"value": Vector2(64, 48)
}
